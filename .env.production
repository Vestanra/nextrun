# Production build (public GitHub Pages demo).
# Runs against bundled static seed data (src/lib/demoEvents.ts) — NO live
# backend. The MockAPI free tier is unauthenticated, so a live endpoint in a
# public repo could be wiped or spammed by anyone; static data keeps the demo
# tamper-proof. Registrations persist for the session only.
VITE_STATIC_DEMO=true
