# Backend configuration.
#
# The app ships working out of the box: `npm run dev` uses bundled static demo
# data (see .env.development, VITE_STATIC_DEMO=true) — no MockAPI needed.
#
# To run against a real MockAPI backend instead, copy this file to .env.local
# and set both:
#   VITE_STATIC_DEMO=false
#   VITE_API_BASE_URL=https://YOUR_PROJECT_ID.mockapi.io/api/v1
VITE_API_BASE_URL=https://YOUR_PROJECT_ID.mockapi.io/api/v1
