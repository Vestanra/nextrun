# Local dev default (committed on purpose, not gitignored).
# Makes `npm run dev` work immediately after `git clone` — no setup, no backend:
# the app runs against bundled static seed data (src/lib/demoEvents.ts).
#
# To develop against a real MockAPI instead, create `.env.development.local`
# (gitignored) with:
#   VITE_STATIC_DEMO=false
#   VITE_API_BASE_URL=https://<your-project-id>.mockapi.io/api/v1
VITE_STATIC_DEMO=true
